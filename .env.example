# 复制为本仓库根目录的 .env（已被 Git 忽略）。不要提交真实密码或模型 Key。
# python3 project.py 与 PHP 启动时会读取 .env；已经存在的环境变量不会被覆盖。
# 不要在行尾写注释。值含空格时用单引号或双引号包起来。

# 仅首次 python3 project.py start 用来创建独立数据库。管理账户需要建库、建用户和授权。
# 留空密码表示本机 root 空密码。程序不会重置已有 .local/native.json。
MVP_DB_ADMIN_HOST=127.0.0.1
MVP_DB_ADMIN_USER=root
MVP_DB_ADMIN_PASSWORD=

# 选题与草稿脚本使用的模型 Key。对应 scripts/editorial/config.example.json 的 api_key_env。
# systemd 部署仍可只用 scripts/deploy/editorial.env.example 中的同名变量。
EDITORIAL_API_KEY=

# 可选。测试脚本优先读这个变量，否则读取 .local/admin-credentials.txt。
# MVP_TEST_PASSWORD=

# 可选。定制交付时替换页脚联系方式与赞助码，不必改 PHP。留空则使用程序内置的维护者信息。
# 邮箱须为合法邮箱；微信为字母数字下划线或短横线；赞助码须为 https 图片地址。非法值会被忽略。
LORE_CONTACT_EMAIL=
LORE_CONTACT_WECHAT=
LORE_SPONSOR_WECHAT_URL=
LORE_SPONSOR_ALIPAY_URL=
