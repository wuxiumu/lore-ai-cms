# Replace __DOMAIN__, __ROOT__, __FPM_SOCKET__. Add your real certificate before enabling.
server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://__DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    root __ROOT__/new-project/app/public;
    client_max_body_size 2m;
    charset utf-8;
    add_header X-Content-Type-Options nosniff always;
    location = /style.css { try_files $uri =404; expires 1h; }
    location ~ ^/covers/[a-z-]+\.svg$ { try_files $uri =404; expires 1d; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:__FPM_SOCKET__;
    }
    location ~ /\. { return 404; }
    location ~ \.php(?:/|$) { return 404; }
    location / { rewrite ^ /index.php last; }
}
